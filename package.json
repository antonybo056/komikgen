{
  "name": "komikgen",
  "productName": "KomikGen",
  "version": "1.0.0",
  "description": "Kendi çizgi romanını oluşturan masaüstü uygulaması",
  "main": "main.js",
  "author": "antonybo056",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.komikgen.app",
    "productName": "KomikGen",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "KomikGen-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3"
  }
}
